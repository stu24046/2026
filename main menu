extends Control

@onready var main_button: VBoxContainer = $MainButton
@onready var options_pnl: Panel = $Options
@onready var options_btn: Button = $MainButton/Options

func _ready() -> void:
	self.main_button.show()
	self.options_pnl.hide()
	
	options_btn.pressed.connect(_on_settings_pressed)
	
func _process(delta: float) -> void:
	pass

func _on_start_pressed() -> void:
	get_tree().change_scene_to_file("res://assets/node_2d.tscn")

func _on_settings_pressed() -> void:
	print("Settings pressed")
	self.main_button.hide()
	self.options_pnl.show()

func _on_exit_pressed() -> void:
	get_tree().quit()


func _on_back_pressed() -> void:
	_ready()
